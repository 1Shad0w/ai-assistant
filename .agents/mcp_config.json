{
  "mcpServers": {
    "google-workspace": {
      "command": "npx",
      "args": ["-y", "@aaronsb/google-workspace-mcp"]
    },
    "puppeteer": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${HOME}/Documents/ai-assistant-workspace",
        "${HOME}/Desktop/ai-assistant"
      ]
    },
    "omniroute": {
      "command": "omniroute",
      "args": ["--mcp"]
    }
  }
}
